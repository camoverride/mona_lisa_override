[Unit]
Description=Display Mona Lisa
After=graphical.target
Wants=graphical.target

[Service]
User=cam
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/cam/.Xauthority
Environment=WAYLAND_DISPLAY=wayland-0
WorkingDirectory=/home/cam/mona_lisa_override
ExecStart=/home/cam/mona_lisa_override/.venv/bin/python /home/cam/mona_lisa_override/run_display.py
Restart=always

[Install]
WantedBy=graphical.target
